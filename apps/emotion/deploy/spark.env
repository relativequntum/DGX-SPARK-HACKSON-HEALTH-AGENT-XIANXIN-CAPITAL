# shellcheck shell=bash
# 阶段三（judge / face_body）在 DGX Spark 上的运行参数。setup_spark.sh、自动判断服务和日常命令都先 source 它。
# 这个文件随每次部署整体替换，在 Spark 上改它下次部署就没了：要改的参数写进本机覆盖文件
# ~/.config/emotion/spark.local.env（不随部署替换），一行一个普通赋值，例如 PROXY=http://<局域网代理>。
# 覆盖文件最先读：它写了的变量以它为准（也优先于命令行临时给的同名环境变量），没写的用下面的默认值；
# 由别的变量推出的默认值跟着变，例如只改 EMOTION_HOME，EMOTION_OUT 也会跟着到新目录下。
: "${EMOTION_LOCAL_ENV:=$HOME/.config/emotion/spark.local.env}"
if [ -f "$EMOTION_LOCAL_ENV" ]; then
  # shellcheck disable=SC1090
  source "$EMOTION_LOCAL_ENV"
fi
: "${EMOTION_HOME:=$HOME/spark-Hackson}"                    # 部署下来的仓库子集（apps/emotion/*），deploy_spark.sh 的 REMOTE_HOME 要与它一致
: "${EMOTION_VENV:=$HOME/emotion-venv}"                     # Python 3.12 venv
: "${EMOTION_OUT:=$EMOTION_HOME/outputs}"                   # judge / face_body 的输出；浏览服务只读这里
: "${VIEWER_PORT:=8020}"                                    # 输出浏览，只监听 127.0.0.1；本机 ssh -L 8020:127.0.0.1:8020 后打开
: "${FACE_BODY_MODEL_DIR:=$HOME/emotion-models/mediapipe}"  # MediaPipe 模型（不随代码部署，重新部署不会删）
: "${PIP_MIRROR:=https://mirrors.aliyun.com/pypi/simple/}"
: "${PROXY:=}"                                              # 下载慢时填局域网代理，例如阶段二 env.sh 里的 PROXY
# judge 走阶段二的 llama-server（OpenAI 兼容）；变量名与 ~/livetalking-deploy/env.sh 一致
: "${LOCAL_LLM_BASE_URL:=http://127.0.0.1:8080/v1}"
: "${LOCAL_LLM_MODEL:=qwen3.6-35b-a3b}"
: "${LOCAL_LLM_KEY_FILE:=$HOME/qwen-spark/secrets/model-api-key}"
: "${CONSULT_DIR:=$HOME/livetalking-logs/consultations}"    # 数字人 consult_recorder 的问诊记录（judge 可直接读 .jsonl）
: "${LT_ADMIN_URL:=http://127.0.0.1:8010/api/admin/sessions}" # 数字人在线会话；自动判断在有人问诊时让路
# 患者页摄像头观察的关键点数值（阶段二 doctor_service 写入）；与 ~/livetalking-deploy/env.sh 的 DOCTOR_OBS_DIR 必须相同
: "${EMOTION_OBS_DIR:=$HOME/livetalking-logs/observations}"
export EMOTION_HOME EMOTION_VENV EMOTION_OUT VIEWER_PORT FACE_BODY_MODEL_DIR PIP_MIRROR PROXY \
       LOCAL_LLM_BASE_URL LOCAL_LLM_MODEL LOCAL_LLM_KEY_FILE CONSULT_DIR LT_ADMIN_URL EMOTION_OBS_DIR
